# 复制为 .env 后按需修改。  cp .env.example .env
# 本文件是唯一的配置源；backend/.env 只作为「本机私密覆盖」存在（例如放聊天 Key）。
# Docker 部署由 docker-compose.yml 的 environment 段覆盖 DATABASE_URL / UPLOAD_DIR，
# 所以本文件可以固定写 SQLite，本机与容器两条路都不会打架。
APP_NAME=明猎智能问答系统
APP_ENV=development
SECRET_KEY=change-this-before-use
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-use

# ---- 数据库与上传目录 ----
# 本机快速开发用 SQLite；Docker 会被 compose 覆盖成 postgres + /data/uploads
DATABASE_URL=sqlite:///./minglie.db
UPLOAD_DIR=./uploads

# ---- 聊天 / 结构化抽取模型 ----
# mock = 离线规则（无需 Key，适合现场演示）；deepseek / openai = 云端
MODEL_MODE=mock
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
CHAT_API_KEY=

# ---- Embedding（独立配置，绝不复用聊天 Key）----
# DeepSeek 没有公开 embedding 接口，向量化必须单独配一家。
# provider: hash / siliconflow / zhipu / dashscope / openai
#   hash        = 本地确定性哈希占位向量（无语义，仅供离线演示；审计标记为 placeholder）
#   siliconflow = 硅基流动，推荐 BAAI/bge-m3，1024 维，有免费额度
#   zhipu       = 智谱 BigModel，embedding-3
#   dashscope   = 阿里云百炼（通义），text-embedding-v3
#
# 配置真实向量服务的三步：
#   1) EMBEDDING_PROVIDER=siliconflow
#   2) EMBEDDING_API_KEY=sk-xxxx
#   3) EMBEDDING_DIMENSIONS=0        # 0 = 使用该服务商原生维度
# 配置完必须重建向量（维度变了，旧向量会被检索跳过）：
#   cd backend && python -m scripts.reindex_embeddings
EMBEDDING_PROVIDER=hash
EMBEDDING_MODE=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0

# ---- 最终重排（决定 20% 的 rerank_score，其余 80% 是结构化与语义分）----
# rule = 关键词覆盖打分：免费、离线、可复现（默认）
# llm  = 一次批量大模型调用给 top-N 候选人打分，需要聊天 Key；
#        调用失败会自动退回 rule，不会让检索失败
# 两种模式可以用同一套评测集直接对比：
#   python -m scripts.evaluate --rerank rule --out eval/results_rerank_rule.json
#   python -m scripts.evaluate --rerank llm  --out eval/results_rerank_llm.json
RERANK_MODE=rule
RERANK_TOP_N=20

MAX_UPLOAD_MB=20
WEB_ORIGIN=http://localhost:5173

# ---- 检索编排方式 ----
# pipeline  = 固定流水线：召回 → 打分 → 解释（默认，最稳）
# langgraph = LangGraph 状态图：召回 → 质量评估 →（不够就自动改写查询重查，上限 2 轮）→ 生成
#             任何节点失败会自动退回 pipeline，不会让检索失败
ORCHESTRATION_MODE=pipeline
